{
  "name": "masd-engineering-toolbox",
  "productName": "MASD Engineering Toolbox",
  "version": "0.1.0",
  "appRevision": "00.01.000",
  "description": "ModuLaser MASD design configuration, battery calculation, legacy migration and field-change approval.",
  "author": "Brent",
  "license": "GPL-3.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && node scripts/dist.js"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "net.masdtools.toolbox",
    "productName": "MASD Engineering Toolbox",
    "files": [
      "main.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MASD Engineering Toolbox"
    }
  }
}
